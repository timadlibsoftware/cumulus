#!/usr/bin/env bash
# gh wrapper: runs the real GitHub CLI with a fresh run-scoped token in GH_TOKEN (C-10).
# Installed at /usr/local/bin/gh, ahead of the real /usr/bin/gh on PATH.
set -euo pipefail

real_gh="${CUMULUS_REAL_GH:-/usr/bin/gh}"
if [[ -z "${GH_TOKEN:-}" ]]; then
  GH_TOKEN="$(cumulus-github-token)"
  export GH_TOKEN
fi
exec "$real_gh" "$@"
