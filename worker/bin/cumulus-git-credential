#!/usr/bin/env bash
# git credential helper (gitcredentials(7)) backed by cumulus-github-token. Only `get` answers;
# `store` and `erase` are no-ops because every request fetches a fresh short-lived token.
set -euo pipefail

[[ "${1:-}" == "get" ]] || exit 0
cat > /dev/null # consume the request attributes
token="$(cumulus-github-token)"
printf 'username=x-access-token\npassword=%s\n' "$token"
